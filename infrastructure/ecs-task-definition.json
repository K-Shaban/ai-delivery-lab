{
  "family": "ai-delivery-lab",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::200978365775:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::200978365775:role/aiDeliveryLabTaskRole",
  "containerDefinitions": [
    {
      "name": "ai-delivery-lab",
      "image": "200978365775.dkr.ecr.ap-southeast-2.amazonaws.com/ai-delivery-lab:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MODEL_PATH",
          "value": "/app/artifacts/inactivity_risk_model.joblib"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-delivery-lab",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}